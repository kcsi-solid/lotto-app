{
  "name": "lotto-analyzer",
  "version": "1.0.0",
  "description": "동행복권 1회~최신 회차를 시계열 순서로 분석해 번호를 생성하는 PWA",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "python -m http.server 8000",
    "test": "node tools/selftest.mjs && node tools/uitest.mjs",
    "test:engine": "node tools/selftest.mjs",
    "test:ui": "node tools/uitest.mjs",
    "backtest": "node tools/backtest.mjs",
    "fetch": "python tools/fetch_draws.py",
    "build": "node tools/build.mjs",
    "test:dist": "node tools/disttest.mjs",
    "screenshots": "node tools/make_screenshots.mjs",
    "android:sync": "npm run build && npx cap sync android",
    "android": "npm run android:sync && npx cap run android",
    "android:open": "npm run android:sync && npx cap open android",
    "ads:status": "node tools/set-ad-ids.mjs status",
    "ads:test": "node tools/set-ad-ids.mjs test",
    "ads:live": "node tools/set-ad-ids.mjs live",
    "android:bundle": "npm run android:sync && cd android && .\\gradlew.bat bundleRelease"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "jsdom": "^30.0.0",
    "puppeteer": "^25.11.0"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.1.0",
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capgo/native-purchases": "^8.7.0"
  }
}
